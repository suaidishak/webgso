# Copy to .env and change before sharing the beta with anyone.
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts plant API keys at rest. Set once and keep it (changing it makes stored keys unreadable).
PLANT_KEY_SECRET=change-me-to-another-long-random-string
ADMIN_EMAIL=admin@gso.local
ADMIN_PASSWORD=admin12345
TIMEZONE=Asia/Kuala_Lumpur
SCHEDULER_TICK_SECONDS=30
SCHEDULER_CATCHUP_MINUTES=10
VERIFY_TLS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Report emails after scheduled retrievals (Email reports page).
# With docker compose and no SMTP_HOST here, emails go to the local Mailpit catcher: http://localhost:8025
# For real email, set your mail server, for example Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURITY=starttls        # starttls | ssl | none
#   SMTP_USERNAME=reports@your-domain.com.my
#   SMTP_PASSWORD=app-password-here
MAIL_FROM=GSO Solar Data Platform <noreply@gso.local>
# MAIL_REPLY_TO=gso-admin@your-domain.com.my
# Address of the web app, used for the "Open in the platform" link in emails.
PUBLIC_BASE_URL=http://localhost:8080
# A failed email is tried again after these minutes, then marked failed.
EMAIL_RETRY_MINUTES=1,5,15,60
